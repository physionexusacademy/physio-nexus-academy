# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Original optimized pathway photos, served directly by Cloudflare static assets.
/images/pathway-backgrounds/*
  Cache-Control: public,max-age=86400

# Site images (logos, cards, faculty) — long cache; filenames change on replace
/images/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

# RehabVerse exercise data: regenerated on deploy; revalidate hourly.
/rehabverse-data/*
  Cache-Control: public,max-age=3600,stale-while-revalidate=86400

/icons/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

# PWA runtime files must revalidate so installed apps receive new deployments promptly.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/offline.html
  Cache-Control: no-cache, must-revalidate

# The PNA Teacher's recorded voice: a pack's file name carries a hash of its content, so it never changes — keep it for a year.
# (packs.json and clips.json are small and revalidated as usual, so a new recording shows up at once.)
/voice/george/*.mp3
  Cache-Control: public,max-age=31536000,immutable

# Form Check (camera): the pose library's wasm and the pinned model files. Each is checked against src/lib/formcheck/assets.lock.json at deploy; they change only with a new lock.
/formcheck/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

# Lesson, skill, condition and manual-therapy data: regenerated on every deploy. Kept five minutes in the browser (a second visit
# opens instantly) and served stale for a day while the browser checks for a new copy, so a new deploy still shows up quickly.
/teacher-data/*
  Cache-Control: public,max-age=300,stale-while-revalidate=86400

# The daily challenge's lesson questions are read by the worker through the assets binding; always revalidated so a deploy is never served an older pool.
/daily-content/*
  Cache-Control: public,max-age=0,must-revalidate

/skills-data/*
  Cache-Control: public,max-age=300,stale-while-revalidate=86400

/conditions-data/*
  Cache-Control: public,max-age=300,stale-while-revalidate=86400

/manual-therapy-data/*
  Cache-Control: public,max-age=300,stale-while-revalidate=86400

/virtual-patient/*
  Cache-Control: public,max-age=300,stale-while-revalidate=86400

# The teacher's pictures: replaced under a new name, so a week is safe.
/teacher/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400

# Full Posture Scan: the bones of the 3D skeleton. The files change only when the skeleton is rebuilt, so they are revalidated weekly.
/posture-skeleton/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
