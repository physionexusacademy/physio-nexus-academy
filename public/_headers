# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Original optimized pathway photos, served directly by Cloudflare static assets.
/images/pathway-backgrounds/*
  Cache-Control: public,max-age=86400


# PWA runtime files must revalidate so installed apps receive new deployments promptly.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate

/offline.html
  Cache-Control: no-cache, must-revalidate
