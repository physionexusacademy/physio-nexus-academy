{
  "name": "physio-nexus-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "next lint",
    "validate:msk": "node --experimental-strip-types scripts/validate-msk-checker.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "validate:unified-progress": "node --experimental-strip-types scripts/validate-unified-progress.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@opennextjs/cloudflare": "1.20.13",
    "@supabase/ssr": "^0.5.1",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.427.0",
    "next": "15.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.52.2",
    "tailwind-merge": "^2.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^6.1.5",
    "rimraf": "^6.0.1"
  }
}