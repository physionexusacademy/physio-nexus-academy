# ── Supabase (wired in Stage 2) ─────────────────────────────────────────
# Found in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose this with NEXT_PUBLIC_ prefix, never commit it
SUPABASE_SERVICE_ROLE_KEY=

# ── Dedicated Clinical Registry Supabase project ────────────────────────
# Separate from the main PNA website Supabase project.
NEXT_PUBLIC_CLINICAL_REGISTRY_SUPABASE_URL=
# Preferred publishable key; legacy anon-key variable is supported as fallback.
NEXT_PUBLIC_CLINICAL_REGISTRY_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLINICAL_REGISTRY_SUPABASE_ANON_KEY=
# Keep empty until the institution/ethics-approved signed consent form version is confirmed.
NEXT_PUBLIC_CLINICAL_REGISTRY_CONSENT_VERSION=

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://physionexusacademy.com

# ── Clinical image CDN (ImageKit) ────────────────────────────────────────
# Public delivery endpoint only. Example: https://ik.imagekit.io/your_imagekit_id
# ClinicalImage uses direct browser delivery, responsive srcset and lazy loading.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Enable only after the first realistic 3D anatomy assets are uploaded.
# When false, no 3D-image button is rendered and no ImageKit request is made.
NEXT_PUBLIC_IMAGEKIT_3D_ENABLED=false

# ── Email notifications (optional, Stage 2+) ────────────────────────────
# If unset, the app runs fine — email notifications are simply skipped.
RESEND_API_KEY=
RESEND_FROM_EMAIL=PNA Clinical Registry <onboarding@resend.dev>
NOTIFICATION_EMAIL_TO=physionexusacademypk@gmail.com

# ── Payments (optional, future module — keep disabled until configured) ─
PAYMENTS_ENABLED=false


# ── Clinical 3D anatomy CDN (Cloudinary) ────────────────────────────────
# Public delivery settings. Keep 3D disabled until the first assets are uploaded.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_3D_ENABLED=false

# Server/local upload helper only. Never expose with NEXT_PUBLIC_.
# Create one restricted unsigned upload preset for PNA clinical anatomy.
CLOUDINARY_UNSIGNED_UPLOAD_PRESET=
