# ── Supabase (wired in Stage 2) ─────────────────────────────────────────
# Found in your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — NEVER expose this with NEXT_PUBLIC_ prefix, never commit it
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://physionexusacademy.com

# ── Clinical image CDN (ImageKit) ────────────────────────────────────────
# Public delivery endpoint only. Example: https://ik.imagekit.io/your_imagekit_id
# ClinicalImage uses direct browser delivery, responsive srcset and lazy loading.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ── Email notifications (optional, Stage 2+) ────────────────────────────
# If unset, the app runs fine — email notifications are simply skipped.
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=

# ── Payments (optional, future module — keep disabled until configured) ─
PAYMENTS_ENABLED=false
